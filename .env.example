# Database
DATABASE_URL=postgres://user:pass@host/db

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_FILTER_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=gpt-4o

# Gmail SMTP
GMAIL_USER=eyosavage767655@gmail.com
GMAIL_APP_PASSWORD=

# Auth
CRON_SECRET=
ADMIN_TOKEN=

# Business identity (CAN-SPAM)

# ── Required (set in Vercel → Settings → Environment Variables) ──

# Database — Vercel Neon integration sets these automatically; app uses DATABASE_URL or POSTGRES_URL
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_FILTER_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=gpt-4o

# xAI Grok — optional but strongly recommended. When set, contact discovery
# uses Grok's built-in live web search to find the right outreach email for
# each scraped company, with citations. Falls back to DuckDuckGo + on-site
# scraping when unset.
GROK_API_KEY=xai-...
GROK_MODEL=grok-4-fast-non-reasoning

# Gmail SMTP (GMAIL_USER defaults to CONTACT_EMAIL if omitted)
GMAIL_USER=eyosavage767655@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password

# Auth — generate random strings (min 8 chars each)
CRON_SECRET=your-random-cron-secret
ADMIN_TOKEN=your-random-admin-token

# Business identity (CAN-SPAM)
BUSINESS_NAME=TalentBridge
BUSINESS_ADDRESS=123 Main St, Anytown, USA
CONTACT_EMAIL=eyosavage767655@gmail.com
UNSUBSCRIBE_MAILTO=eyosavage767655@gmail.com
UNSUBSCRIBE_URL=https://your-app.vercel.app/unsubscribe

# Agent behavior — SAFE DEFAULTS
DRY_RUN=true
AGENT_ENABLED=true
DAILY_EMAIL_LIMIT=100
ENABLE_PATTERN_GUESSING=false
ALLOW_LOW_CONFIDENCE_SEND=false

# ── Set automatically by Vercel Neon integration (do not delete) ──
# POSTGRES_URL
# POSTGRES_PRISMA_URL
# POSTGRES_URL_NON_POOLING
# DATABASE_URL_UNPOOLED
# PGHOST, PGUSER, PGPASSWORD, PGDATABASE, etc.
